{
  "experiment": {
    "attack_method": "off",
    "web_injection_channel": "url",
    "mode": "agent",
    "harness_type": "pi-agent"
  },
  "observation_representation": "backend_native",
  "target": {
    "backend": "anthropic",
    "model": "claude-haiku-5-5",
    "reasoning_effort": "medium",
    "max_response_tokens": null,
    "required_finish_reasons": [
      "stop"
    ],
    "api": "anthropic-messages",
    "temperature": null,
    "api_id": null,
    "client_settings": {
      "base_url": "https://api.anthropic.com/v1",
      "api_key_env": "ANTHROPIC_API_KEY",
      "request_timeout_seconds": 120,
      "request_parameters": {},
      "omit_parameters": [
        "temperature",
        "top_p"
      ],
      "request_headers": {}
    },
    "pi_model": {
      "reasoning": true,
      "input": [
        "text",
        "image"
      ],
      "contextWindow": 1000000,
      "maxTokens": 128000,
      "thinkingLevelMap": {
        "low": "low",
        "medium": "medium",
        "high": "high",
        "xhigh": "xhigh",
        "max": "max"
      },
      "compat": {
        "forceAdaptiveThinking": true,
        "supportsTemperature": false
      }
    },
    "pi_omit_parameters": [
      "temperature",
      "top_p",
      "max_completion_tokens",
      "max_output_tokens",
      "reasoning_effort",
      "reasoning"
    ]
  },
  "task_id": "pi-url-haiku-5-5",
  "output_dir": null,
  "repeats": 4,
  "api_concurrency_per_task": 1,
  "max_attempts": 3,
  "adapter_name": "pi-agent",
  "agent_concurrency": 1,
  "allowed_conditions": [
    "off",
    "on"
  ],
  "tasks": null,
  "artifact": null,
  "agent_pool_dir": "outputs/.agent_slots",
  "adapter_timeout_seconds": 720,
  "tool_config": {
    "max_tool_calls": 20,
    "trajectory_timeout_seconds": 600,
    "proxy_connect_timeout_seconds": 20,
    "mcp_startup_timeout_seconds": 30,
    "mcp_tool_timeout_seconds": 120,
    "pi_http_idle_timeout_seconds": 120,
    "tool_profile": "native"
  },
  "url_prompt_defense": {
    "prompt_file": "prompts/attacker/in_agent_filter.txt",
    "placement": "system"
  }
}
