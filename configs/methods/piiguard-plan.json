{
  "output_dir": "outputs/piiguard-search",
  "prepare_only": true,
  "model": {
    "model": "gpt-6-luna",
    "provider": "openai",
    "request_parameters": {
      "temperature": null,
      "max_tokens": null,
      "reasoning_effort": "medium"
    },
    "client_settings": {
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "request_timeout_seconds": 600,
      "request_parameters": {},
      "omit_parameters": [],
      "request_headers": {}
    }
  },
  "training_base_request_id": "B1",
  "search": {
    "rounds": 10,
    "proposals_per_round": 3,
    "mutation_batch": 3,
    "positions": [
      "contact_block",
      "footer_notice",
      "bio_tail"
    ],
    "exploration_epsilon": 0.15,
    "max_lineage_depth": 3,
    "rng_seed": 42,
    "fragment_budget_chars": 420,
    "eval_tasks_per_candidate": 12,
    "child_eval_workers": 1,
    "low_leak_threshold": 0.25
  },
  "execution": {
    "domain_order": [
      "academic",
      "news"
    ],
    "api_concurrency_per_task_per_api": 10,
    "logical_call_max_attempts": 3,
    "transport_attempt_hard_cap": 3500
  },
  "training_prompts": "data/training_prompts.json",
  "scenarios": {
    "academic": {
      "optimizer_data": "outputs/piiguard-data/academic/optimizer_data.json",
      "final_tasks": "data/benchmark/academic/tasks.json"
    },
    "news": {
      "optimizer_data": "outputs/piiguard-data/news/optimizer_data.json",
      "final_tasks": "data/benchmark/news/tasks.json"
    }
  }
}
